# Copy this file to .env (or .env.local) and fill in real values there.
# Both are gitignored — never commit real keys.
#
# Deliberately NOT using NEXT_PUBLIC_ prefixes: this app has no auth/RLS, so
# these values must never be bundled into browser JavaScript. They're only
# ever read from server-side code (src/lib/supabase/client.ts, called only
# from Server Components) — see the comment there before changing that.

# Project Settings → API → Project URL (no trailing slash, no /rest/v1 suffix)
SUPABASE_URL=

# Project Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role
# Only used by local one-off scripts (e.g. scripts/seed-items.ts), never by
# the app itself. Bypasses all access rules — treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=
