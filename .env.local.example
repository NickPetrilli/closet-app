# Copy this file to .env (or .env.local) and fill in real values there.
# Both are gitignored — never commit real keys.
#
# Deliberately NOT using NEXT_PUBLIC_ prefixes: nothing here needs to reach
# the browser. The app signs people in with Supabase Auth and every table has
# Row Level Security, so the anon key alone can't read anyone's closet; it's
# still only ever read from server-side code (src/lib/supabase/server.ts and
# middleware), which keeps the browser bundle free of config it doesn't need.

# Project Settings → API → Project URL (no trailing slash, no /rest/v1 suffix)
SUPABASE_URL=

# Project Settings → API → Project API keys → anon / public
# The app uses it together with the signed-in user's session cookie.
SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → service_role
# Only used by local one-off scripts (e.g. scripts/seed-items.mjs,
# scripts/set-password.mjs), never by the app itself. Bypasses all access
# rules including RLS — treat it like a password, and never add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# The shared password typed on the lock screen before anyone can sign in or create
# an account (src/lib/gate.ts). Any phrase; matched ignoring case and
# surrounding spaces. It keeps strangers from making accounts, not from reading
# data (RLS does that). Changing it re-locks devices that aren't signed in;
# it never signs anyone out. With it unset, the lock screen lets nobody in.
SITE_PASSWORD=

# Free account at remove.bg → Dashboard → API Key. Powers background removal
# for the Add Item flow (src/lib/server/remove-bg-api.ts). Free tier is 50
# calls/month, no card required — the 51st call in a month just returns an
# error until it resets, never a charge.
REMOVE_BG_API_KEY=

# Google AI Studio → API keys. Powers Generate Outfits and the daily
# suggestion's AI fallback (src/lib/server/gemini.ts). Free tier; quota is
# per model per day and resets at midnight Pacific.
GEMINI_API_KEY=
